{
  "name": "nyaya",
  "version": "1.0.0",
  "description": "Node.js backend server for Nyaya API development",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:check": "node src/scripts/check-db.js",
    "db:init": "node src/scripts/init-db.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed-admin": "node src/scripts/seed-admin.js",
    "db:seed-content": "node src/scripts/seed-content.js",
    "db:seed-articles": "node src/scripts/seed-articles.js",
    "db:update-articles-content": "node src/scripts/update-articles-content.js",
    "test": "node --test src/tests/*.test.js"
  },
  "keywords": [
    "api",
    "express",
    "postgresql",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.6",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4"
  }
