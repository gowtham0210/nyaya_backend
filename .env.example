PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# PostgreSQL. Local dev with docker-compose.dev.yml: 127.0.0.1 / 5433 / nyaya / nyaya / nyaya.
# Server (docker-compose.yml): the Postgres container's name, e.g. yercaud-postgres-1 / 5432.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=nyaya
DB_PASSWORD=nyaya
DB_NAME=nyaya
# DB_SSL=true            # managed Postgres that requires TLS
# DB_NETWORK=yercaud_default  # Docker network of the Postgres container (docker-compose.yml)
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000
JWT_ACCESS_SECRET=replace-with-a-secure-access-secret
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=nyaya_refresh_token
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth
ADMIN_EMAILS=admin@nyaya.local
ADMIN_SEED_FULL_NAME=Nyaya Admin
ADMIN_SEED_EMAIL=admin@nyaya.local
ADMIN_SEED_PASSWORD=NyayaAdmin@2026
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# docker-compose.yml only
# API_PORT=5050
# FRONTEND_PORT=5173
# VITE_API_BASE_URL=http://localhost:5050/api/v1
